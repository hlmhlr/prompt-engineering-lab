# Copy this file to .env and change values if needed.
# None of these are secrets: Ollama runs locally and needs no API key.

# Which Ollama model to use (run `ollama list` to see what you have)
OLLAMA_MODEL=granite4:tiny-h

# Where the Ollama server is running (this is the default)
OLLAMA_BASE_URL=http://localhost:11434
